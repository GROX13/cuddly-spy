{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["context7"],
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(docker ps*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "mcp__context7__*"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git commit *--no-ver*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Edit(/README.md)",
      "Write(/README.md)",
      "Edit(/kotlin/src/test/kotlin/org/ikigaidigital/TimeDepositCalculatorTest.kt)",
      "Write(/kotlin/src/test/kotlin/org/ikigaidigital/TimeDepositCalculatorTest.kt)",
      "Edit(/kotlin/src/test/kotlin/org/ikigaidigital/ArchitectureTest.kt)",
      "Write(/kotlin/src/test/kotlin/org/ikigaidigital/ArchitectureTest.kt)"
    ]
  }
}
