#!/bin/sh
# Agent-agnostic guardrails. Enable once per clone: git config core.hooksPath .githooks
set -e

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -qx 'README.md'; then
  echo "pre-commit: README.md holds the assignment and must stay unchanged. Unstage it: git restore --staged README.md" >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -q '^kotlin/'; then
  echo "pre-commit: kotlin/ changed, running tests..." >&2
  mvn -q -f kotlin/pom.xml test
fi
