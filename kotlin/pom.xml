<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.ikigaidigital</groupId>
    <artifactId>time-deposit-kata-kotlin</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>XA Bank Time Deposits</name>
    <description>Time deposit API for the XA Bank kata</description>

    <properties>
        <java.version>17</java.version>
        <kotlin.code.style>official</kotlin.code.style>
        <springdoc.version>3.2.0</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <kover.version>0.9.11</kover.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Spring Data JPA with Hibernate for the persistence adapter; also brings the DataSource Liquibase uses. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Boot 4 keeps the Liquibase auto-configuration in its own module, which this starter brings
             together with liquibase-core. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Jackson 3 (Boot 4 default) lives under the tools.jackson group. -->
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Starts kotlin/compose.yaml for the local profile only (disabled in application.yml). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @DataJpaTest lives in its own module in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <!-- spring: all-open for Spring annotations. jpa: no-arg constructors for JPA entities
                         and, since Kotlin 2.3.20, all-open with the JPA preset (Entity, Embeddable,
                         MappedSuperclass), so lazy associations can be proxied. The explicit options
                         below repeat that preset so the build does not depend on it. -->
                    <compilerPlugins>
                        <plugin>spring</plugin>
                        <plugin>jpa</plugin>
                    </compilerPlugins>
                    <pluginOptions>
                        <option>all-open:annotation=jakarta.persistence.Entity</option>
                        <option>all-open:annotation=jakarta.persistence.MappedSuperclass</option>
                        <option>all-open:annotation=jakarta.persistence.Embeddable</option>
                    </pluginOptions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-noarg</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Runs the *IT classes against real Postgres in the verify phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- The Kover agent appends to target/kover/test.ic instead of starting fresh, so a
                 plain `verify` could reuse coverage from an earlier run. Delete only target/kover
                 at the start of every build. Declared before kover-maven-plugin because both
                 bind to initialize and same-phase executions run in pom order. -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-kover-data</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/kover</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kover-maven-plugin</artifactId>
                <version>${kover.version}</version>
                <executions>
                    <execution>
                        <id>kover</id>
                        <goals>
                            <goal>instrumentation</goal>
                            <goal>report-xml</goal>
                            <goal>report-html</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <rules>
                        <rule>
                            <name>Legacy calculator fully covered</name>
                            <groupBy>CLASS</groupBy>
                            <filters>
                                <includes>
                                    <classes>org.ikigaidigital.TimeDepositCalculator</classes>
                                </includes>
                            </filters>
                            <bounds>
                                <bound>
                                    <coverageUnits>LINE</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                                <bound>
                                    <coverageUnits>BRANCH</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                            </bounds>
                        </rule>
                        <rule>
                            <name>Domain covered</name>
                            <groupBy>PACKAGE</groupBy>
                            <filters>
                                <includes>
                                    <classes>org.ikigaidigital.timedeposit.domain.*</classes>
                                </includes>
                            </filters>
                            <bounds>
                                <bound>
                                    <coverageUnits>LINE</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                                <bound>
                                    <coverageUnits>BRANCH</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                            </bounds>
                        </rule>
                        <!-- Reached only by the Failsafe ITs (TimeDepositRepositoryIT), so it also proves
                             the Kover agent instruments Failsafe. -->
                        <rule>
                            <name>Persistence adapter covered</name>
                            <groupBy>PACKAGE</groupBy>
                            <filters>
                                <includes>
                                    <classes>org.ikigaidigital.timedeposit.adapter.persistence.*</classes>
                                </includes>
                            </filters>
                            <bounds>
                                <bound>
                                    <coverageUnits>LINE</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                                <bound>
                                    <coverageUnits>BRANCH</coverageUnits>
                                    <minValue>100</minValue>
                                </bound>
                            </bounds>
                        </rule>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
